# Copy to ~/.local/state/decision-desk/spectrum.env and chmod 600 it. Never commit the filled-in copy.
# Project id and secret: Photon dashboard, project Settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The line the desk texts from, in +1XXXXXXXXXX form. Use a line nothing else answers.
SPECTRUM_LINE=
# Set to 1 only if you knowingly share this project with another app (it has a webhook).
SPECTRUM_ALLOW_WEBHOOKS=
